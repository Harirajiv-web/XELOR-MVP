{
  "name": "@ind-core/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build -b swc",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "worker": "node --env-file-if-exists=../../.env dist/src/worker.js",
    "eval": "node --env-file-if-exists=../../.env dist/src/eval.js",
    "ai:grounding": "node --env-file-if-exists=../../.env dist/src/ai-grounding.js",
    "start:dev": "node --env-file-if-exists=../../.env node_modules/@nestjs/cli/bin/nest.js start -b swc --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@ind-core/db": "workspace:*",
    "@ind-core/platform": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.36.4",
    "express": "^5.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.9.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
