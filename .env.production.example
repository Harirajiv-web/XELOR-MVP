# ---------------------------------------------------------------------------
# XELOR — production environment. Copy to `.env.production` (git-ignored) and
# fill in real values. Nothing in this file should survive as written.
#
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.production up -d --build
# ---------------------------------------------------------------------------

# The public hostname. Must already resolve to this server before the first start:
# Caddy asks Let's Encrypt for a certificate on boot, and that check fails if DNS
# does not yet point here.
PUBLIC_HOST=xelor.kisancred.com

# The API's own reachable origin for governed spreadsheet-import row writes. This example
# is for the single-host API container. On Vercel set the deployed HTTPS API origin instead.
API_SELF_ORIGIN=http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# Two roles, two passwords, on purpose. indcore_owner owns the schema and runs
# migrations; app_user serves every request and CANNOT bypass row-level security.
# Generate both: openssl rand -base64 32
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
DB_POOL_MAX=10

# 00-init.sql creates app_user with the development literal 'app_pw', which is published
# in this repository. infra/postgres/init/02-app-user-password.sh replaces it with the
# value above during first boot, before anything connects — so set it and it is never used.
# These take effect ONLY on an empty data volume. Changing a password later means an
# ALTER ROLE against the running database as well as an edit here.

# --- Keycloak ---------------------------------------------------------------
# The bootstrap administrator. Used once to sign in and create the realm; change or
# disable it afterwards.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=indcore
KEYCLOAK_CLIENT_ID=indcore-api

# --- AI provider ------------------------------------------------------------
# stub = offline deterministic responder. No model spend, no egress, and the honest
# default: the shipped guides state that no external model API is active.
AI_PROVIDER=stub

# --- Demo flags -------------------------------------------------------------
# BOTH OF THESE DISABLE AUTHENTICATION. Set to true only on a throwaway stack that
# holds nothing but the seeded demo tenants, and never on anything reachable by a
# customer. They are not a convenience setting; they remove the sign-in entirely.
API_PUBLIC_DEMO=false
NEXT_PUBLIC_PUBLIC_DEMO=false
