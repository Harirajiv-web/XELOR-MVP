{
  "name": "@ind-core/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "migrate": "node --import tsx src/migrate.ts",
    "rls-check": "node --import tsx src/rls-check.ts",
    "naming-check": "node --import tsx src/naming-check.ts",
    "perm-check": "node --import tsx src/perm-check.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "demo-reset": "node --import tsx src/demo-reset.ts"
  },
  "dependencies": {
    "@ind-core/platform": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
