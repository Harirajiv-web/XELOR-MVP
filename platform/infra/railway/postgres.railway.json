{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/Dockerfile.postgres",
    "watchPatterns": ["infra/railway/Dockerfile.postgres", "infra/railway/postgres-init.sh"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
