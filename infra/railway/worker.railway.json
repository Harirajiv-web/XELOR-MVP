{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/Dockerfile.api",
    "watchPatterns": ["apps/api/**", "packages/**", "infra/railway/**", "package.json", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "sh infra/railway/start-worker.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
