{
  "name": "ind-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "IND-CORE Manufacturing ERP — boundary-enforced modular monolith (MVP prototype 1). Baseline: DECISIONS-V2 (binding).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @ind-core/platform build && pnpm --filter @ind-core/db build && pnpm --filter @ind-core/api start:dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @ind-core/db migrate",
    "db:rls-check": "pnpm --filter @ind-core/db rls-check",
    "db:perm-check": "pnpm --filter @ind-core/db perm-check",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:perm-check"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2"
  }
}
