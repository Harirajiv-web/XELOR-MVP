# ---------------------------------------------------------------------------
# IND-CORE MVP prototype — local dev environment.
# Copy to `.env` (git-ignored). Values below match infra/docker-compose.yml.
# ---------------------------------------------------------------------------

# --- API ---
API_PORT=3000
NODE_ENV=development

# Hosted investor presentation only. When true, the web UI opens with a read-only demo
# identity and does not redirect to Keycloak. It creates no API bearer token and must not
# be used as a substitute for production authentication.
NEXT_PUBLIC_PUBLIC_DEMO=false

# --- Database (PostgreSQL 17 + pgvector) ---
# The APP connects as a NON-OWNER role (app_user, NOBYPASSRLS) so FORCE RLS is a
# real fail-closed backstop (DECISIONS-V2 §1.2 / §1.6). Migrations run as the owner.
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/indcore
DATABASE_OWNER_URL=postgres://indcore_owner:owner_pw@localhost:5432/indcore
DB_POOL_MAX=10

# --- Valkey (cache + BullMQ) ---
VALKEY_URL=redis://localhost:6379

# --- Keycloak 26 (OIDC) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=indcore
KEYCLOAK_CLIENT_ID=indcore-api

# --- Gotenberg (PDF) ---
GOTENBERG_URL=http://localhost:3002

# --- AI provider (DECISIONS-V2 §1.4 — provider selection is config, not code) ---
# stub   = offline deterministic responder. Zero model spend, always correct. CI default.
# ollama = EDGE tier: a model running on this machine. Nothing leaves the site, no API key,
#          no per-call cost. Requires Ollama running locally with the model pulled.
# The router, governance, budget and hash-chained ai_action_log are identical either way,
# and a feature ALWAYS degrades to the deterministic answer if the model is unreachable or
# its text fails the grounding check — the ERP never blocks on a model.
AI_PROVIDER=stub
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional: a larger local model for `tier: premium` calls — the HYBRID-tier lever.
# OLLAMA_MODEL_PREMIUM=qwen2.5:7b
OLLAMA_TIMEOUT_MS=20000

# --- Demo tenant ids (seed) — canonical universe, DECISIONS-V2 §7 ---
# Trishul Precision Components Pvt Ltd (primary), Kaveri ElectroFab (RLS probe).
DEMO_TENANT_TRISHUL=0192a8c0-0000-7000-8000-000000000001
DEMO_TENANT_KAVERI=0192a8c0-0000-7000-8000-000000000002
