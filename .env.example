# ---------------------------------------------------------------------------
# IND-CORE MVP prototype — local dev environment.
# Copy to `.env` (git-ignored). Values below match infra/docker-compose.yml.
# ---------------------------------------------------------------------------

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL 17 + pgvector) ---
# The APP connects as a NON-OWNER role (app_user, NOBYPASSRLS) so FORCE RLS is a
# real fail-closed backstop (DECISIONS-V2 §1.2 / §1.6). Migrations run as the owner.
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/indcore
DATABASE_OWNER_URL=postgres://indcore_owner:owner_pw@localhost:5432/indcore
DB_POOL_MAX=10

# --- Valkey (cache + BullMQ) ---
VALKEY_URL=redis://localhost:6379

# --- Keycloak 26 (OIDC) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=indcore
KEYCLOAK_CLIENT_ID=indcore-api

# --- Gotenberg (PDF) ---
GOTENBERG_URL=http://localhost:3001

# --- Demo tenant ids (seed) — canonical universe, DECISIONS-V2 §7 ---
# Trishul Precision Components Pvt Ltd (primary), Kaveri ElectroFab (RLS probe).
DEMO_TENANT_TRISHUL=0192a8c0-0000-7000-8000-000000000001
DEMO_TENANT_KAVERI=0192a8c0-0000-7000-8000-000000000002
